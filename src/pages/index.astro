---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featured = allPosts[0];
const archive = allPosts.slice(1);

function readingTime(post: typeof allPosts[number]): number {
  const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.ceil(words / 200));
}

const featuredDate = featured?.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title="Ishpreet" description="Technical research, deep dives, and observations from the intersection of code and craft.">

  <!-- Identity -->
  <section class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 pt-24 sm:pt-32 pb-8">
    <p class="text-lg text-on-surface-variant font-serif italic">
      A developer who can't leave well enough alone.
    </p>
  </section>

  <!-- Featured Investigation -->
  {featured && (
    <section class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 pb-16 sm:pb-24">
      <p class="text-xs uppercase tracking-wider text-on-surface-variant mb-6">
        Current Research
      </p>

      <a href={`/blog/${featured.id}`} class="group block max-w-[780px]">
        <div class="flex items-center gap-2 text-sm text-on-surface-variant mb-4">
          {featured.data.tags[0] && (
            <span class="inline-block px-3 py-0.5 rounded-full bg-tag-bg text-tag-text text-xs uppercase tracking-wider">
              {featured.data.tags[0]}
            </span>
          )}
          <span class="text-on-surface-variant/40">&middot;</span>
          <time datetime={featured.data.date.toISOString()}>{featuredDate}</time>
          <span class="text-on-surface-variant/40">&middot;</span>
          <span>{readingTime(featured)} min read</span>
        </div>

        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-on-surface leading-tight group-hover:text-primary transition-colors duration-150 mb-6">
          {featured.data.title}
        </h1>

        <p class="text-lg text-on-surface-variant max-w-[60ch] mb-6">
          {featured.data.description}
        </p>

        <span class="text-primary text-sm group-hover:underline">
          Read the investigation &rarr;
        </span>
      </a>
    </section>
  )}

  {!featured && (
    <section class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 pb-16 sm:pb-24">
      <p class="text-on-surface-variant">
        First investigation coming soon.
      </p>
    </section>
  )}

  <!-- Archive -->
  {archive.length > 0 && (
    <section class="bg-surface-low">
      <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
        <h2 class="text-xs uppercase tracking-wider text-on-surface-variant mb-10">
          Archive
        </h2>

        <div class="max-w-[680px] flex flex-col gap-10">
          {archive.map((post) => (
            <ArticleCard
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              tags={post.data.tags}
              slug={post.id}
              readingTime={readingTime(post)}
            />
          ))}
        </div>

        <div class="mt-12">
          <a href="/blog" class="text-primary text-sm hover:underline">
            View all articles &rarr;
          </a>
        </div>
      </div>
    </section>
  )}
</Base>
