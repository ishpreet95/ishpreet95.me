<div
  id="reading-progress"
  class="hidden lg:block fixed left-8 top-20 bottom-20 w-0.5"
  aria-hidden="true"
>
  <div
    id="reading-progress-bar"
    class="w-full bg-primary origin-top"
    style="height: 0%; transition: height 50ms ease-out;"
  ></div>
</div>

<script is:inline>
  (function() {
    var handler = null;
    function initReadingProgress() {
      var bar = document.getElementById('reading-progress-bar');
      if (handler) window.removeEventListener('scroll', handler);
      if (!bar) return;
      handler = function() {
        var scrollTop = window.scrollY;
        var docHeight = document.documentElement.scrollHeight - window.innerHeight;
        var progress = docHeight > 0 ? Math.min((scrollTop / docHeight) * 100, 100) : 0;
        bar.style.height = progress + '%';
      };
      window.addEventListener('scroll', handler, { passive: true });
      handler();
    }
    initReadingProgress();
    document.addEventListener('astro:after-swap', initReadingProgress);
  })();
</script>
