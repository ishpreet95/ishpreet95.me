---
import Base from '../../layouts/Base.astro';
import PatternCover from '../../components/PatternCover.astro';
import { getCollection, render } from 'astro:content';
import { getAccentHue } from '../../lib/accent-hue';
import { readingTime as calcReadingTime } from '../../lib/reading-time';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const body = post.body ?? '';
const readingTime = calcReadingTime(body);

// Per-article accent hue: explicit frontmatter or derived from content
const accentHue = getAccentHue(post.data.accentHue, body);

// Extract h2 headings for TOC sidebar
const headings = body
  .match(/^## (.+)$/gm)
  ?.map((h: string) => h.replace(/^## /, ''))
  ?? [];

// Get prev/next posts for navigation
const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const currentIdx = allPosts.findIndex((p) => p.id === post.id);
const prevPost = currentIdx < allPosts.length - 1 ? allPosts[currentIdx + 1] : null;
const nextPost = currentIdx > 0 ? allPosts[currentIdx - 1] : null;
---

<Base
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  accentHue={accentHue}
  article={{
    publishedTime: post.data.date.toISOString(),
    tags: post.data.tags,
  }}
>
  <!-- Reading progress moved to TOC sidebar -->

  <div class="relative max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-12 pt-10 pb-0">
    <div class="grid grid-cols-1 lg:grid-cols-[220px_1fr] gap-6 lg:gap-16 items-start">

      <!-- Left sidebar — sticky TOC with progress rail + copy link -->
      <aside class="hidden lg:block pt-10 sticky top-10">
        {headings.length >= 2 && (
          <div class="relative">
            <div class="eyebrow mb-4">Contents</div>
            <div class="relative">
              <div
                class="absolute left-0 top-0 w-[2px] rounded-full"
                style="height: 100%; background: var(--ghost-border);"
              />
              <div
                id="toc-progress-rail"
                class="absolute left-0 top-0 w-[2px] rounded-full"
                style="height: 0%; background: var(--primary); transition: height 150ms ease-out;"
              />
              <ol id="article-toc" class="list-none p-0 m-0 grid gap-2.5">
                {headings.map((h: string, i: number) => (
                  <li
                    class="grid gap-2 text-[13px] text-on-surface-variant leading-relaxed pl-3"
                    style="grid-template-columns: 20px 1fr;"
                    data-toc-idx={i}
                  >
                    <span class="font-mono text-[10px] opacity-60">{String(i + 1).padStart(2, '0')}</span>
                    <span>{h}</span>
                  </li>
                ))}
              </ol>
            </div>
          </div>
        )}

        <div class="mt-10">
          <button
            id="copy-link-btn"
            class="inline-flex items-center gap-1.5 px-3 py-2 text-xs text-on-surface-variant rounded-md hover:text-on-surface transition-colors"
            style="box-shadow: inset 0 0 0 1px var(--ghost-border);"
          >
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="11" height="11" rx="2" />
              <path d="M5 15V5a2 2 0 0 1 2-2h10" />
            </svg>
            <span id="copy-link-text">Copy link</span>
          </button>
        </div>
      </aside>

      <!-- Article content -->
      <article class="py-10">
        <!-- Back link -->
        <a href="/blog" class="text-[13px] text-on-surface-variant inline-flex items-center gap-1.5 mb-7 hover:text-on-surface transition-colors">
          &larr; All writing
        </a>

        <!-- Cover pattern -->
        <div class="mb-8">
          <PatternCover seed={post.id} height={140} />
        </div>

        <!-- Meta -->
        <div class="flex items-center gap-2.5 mb-6 flex-wrap">
          {post.data.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
          <span class="font-mono text-[13px] text-on-surface-variant">
            {formattedDate} &middot; {readingTime} min
          </span>
        </div>

        <h1 class="font-serif text-3xl sm:text-4xl lg:text-[52px] leading-[1.05] font-medium tracking-tight text-on-surface mb-5" style="text-wrap: balance;">
          {post.data.title}
        </h1>

        <p class="text-[19px] text-on-surface-variant leading-relaxed max-w-[56ch] mb-12">
          {post.data.description}
        </p>

        <hr class="hr-tonal" />

        <!-- Article body -->
        <div class="prose prose-lg">
          <Content />
        </div>

        <!-- Article footer -->
        <div class="mt-20 pt-10" style="border-top: 1px solid var(--ghost-border);">
          <div class="flex flex-wrap gap-2 mb-9">
            {post.data.tags.map((tag) => (
              <span class="tag ghost">{tag}</span>
            ))}
          </div>

          {(prevPost || nextPost) && (
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              {prevPost && (
                <a href={`/blog/${prevPost.id}`} class="block p-5 bg-surface-low rounded-[10px] hover:opacity-80 transition-opacity">
                  <div class="eyebrow mb-2" style="font-size: 10px;">Previous</div>
                  <div class="font-serif text-[17px] text-on-surface leading-snug">
                    {prevPost.data.title}
                  </div>
                </a>
              )}
              {nextPost && (
                <a href={`/blog/${nextPost.id}`} class="block p-5 bg-surface-low rounded-[10px] text-right hover:opacity-80 transition-opacity" style={!prevPost ? 'grid-column: 2;' : ''}>
                  <div class="eyebrow mb-2" style="font-size: 10px;">Next</div>
                  <div class="font-serif text-[17px] text-on-surface leading-snug">
                    {nextPost.data.title}
                  </div>
                </a>
              )}
            </div>
          )}
        </div>
      </article>
    </div>
  </div>
</Base>

<script is:inline>
  (function() {
    var scrollHandler = null;
    var copyHandler = null;

    function initArticleScripts() {
      // --- TOC scroll-spy + progress rail ---
      if (scrollHandler) window.removeEventListener('scroll', scrollHandler);

      var toc = document.getElementById('article-toc');
      var rail = document.getElementById('toc-progress-rail');
      if (toc) {
        var items = toc.querySelectorAll('[data-toc-idx]');
        var article = document.querySelector('.prose');
        if (items.length > 0 && article) {
          var h2s = article.querySelectorAll('h2');

          scrollHandler = function() {
            var activeIdx = 0;
            var scrollY = window.scrollY + 100;
            for (var i = 0; i < h2s.length; i++) {
              if (h2s[i].getBoundingClientRect().top + window.scrollY <= scrollY) {
                activeIdx = i;
              }
            }
            for (var j = 0; j < items.length; j++) {
              items[j].style.color = j === activeIdx ? 'var(--on-surface)' : 'var(--on-surface-variant)';
            }
            if (rail && items.length > 0) {
              var tocTop = toc.getBoundingClientRect().top + window.scrollY;
              var activeItem = items[activeIdx];
              var itemTop = activeItem.getBoundingClientRect().top + window.scrollY;
              var filledHeight = (itemTop - tocTop) + activeItem.offsetHeight;
              rail.style.height = Math.min(100, Math.max(0, (filledHeight / toc.offsetHeight) * 100)) + '%';
            }
          };
          window.addEventListener('scroll', scrollHandler, { passive: true });
          scrollHandler();
        }
      }

      // --- Copy link ---
      var btn = document.getElementById('copy-link-btn');
      var label = document.getElementById('copy-link-text');
      if (btn && label) {
        if (copyHandler) btn.removeEventListener('click', copyHandler);
        copyHandler = function() {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(window.location.href).then(function() {
              label.textContent = 'Copied!';
              setTimeout(function() { label.textContent = 'Copy link'; }, 2000);
            }).catch(function() {
              label.textContent = 'Failed';
              setTimeout(function() { label.textContent = 'Copy link'; }, 2000);
            });
          }
        };
        btn.addEventListener('click', copyHandler);
      }
    }

    initArticleScripts();
    document.addEventListener('astro:after-swap', initArticleScripts);
  })();
</script>
