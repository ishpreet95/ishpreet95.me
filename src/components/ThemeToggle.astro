---
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle dark/light theme"
  class="w-11 h-11 flex items-center justify-center rounded-full text-on-surface-variant hover:text-on-surface transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2"
>
  <!-- Sun icon (shown in dark mode — click to go light) -->
  <svg id="icon-sun" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
  </svg>
  <!-- Moon icon (shown in light mode — click to go dark) -->
  <svg id="icon-moon" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
    <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
  </svg>
</button>

<script>
  let _themeClickHandler: (() => void) | null = null;

  function initTheme() {
    const toggle = document.getElementById('theme-toggle');
    const sunIcon = document.getElementById('icon-sun');
    const moonIcon = document.getElementById('icon-moon');
    if (!toggle || !sunIcon || !moonIcon) return;

    function updateIcons() {
      const isLight = document.documentElement.classList.contains('light');
      sunIcon!.classList.toggle('hidden', isLight);
      moonIcon!.classList.toggle('hidden', !isLight);
    }

    updateIcons();

    // Remove previous handler before adding a new one
    if (_themeClickHandler) toggle.removeEventListener('click', _themeClickHandler);

    _themeClickHandler = () => {
      document.documentElement.classList.add('transitioning');
      document.documentElement.classList.toggle('light');

      const isLight = document.documentElement.classList.contains('light');
      localStorage.setItem('theme', isLight ? 'light' : 'dark');
      updateIcons();

      setTimeout(() => {
        document.documentElement.classList.remove('transitioning');
      }, 150);
    };

    toggle.addEventListener('click', _themeClickHandler);
  }

  initTheme();
  document.addEventListener('astro:after-swap', initTheme);
</script>
