---
interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  slug: string;
  readingTime?: number;
}

const { title, description, date, tags, slug, readingTime } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="group">
  <a href={`/blog/${slug}`} class="block">
    <div class="flex items-center gap-2 text-sm text-on-surface-variant mb-2">
      {tags[0] && (
        <>
          <span class="inline-block px-3 py-0.5 rounded-full bg-tag-bg text-tag-text text-xs uppercase tracking-wider">
            {tags[0]}
          </span>
          <span class="text-on-surface-variant/40">&middot;</span>
        </>
      )}
      <time datetime={date.toISOString()}>{formattedDate}</time>
    </div>

    <h3 class="font-serif text-xl sm:text-2xl text-on-surface group-hover:text-primary transition-colors duration-150 mb-2">
      {title}
    </h3>

    <p class="text-on-surface-variant text-base line-clamp-2 mb-2">
      {description}
    </p>

    {readingTime && (
      <span class="text-sm text-on-surface-variant">
        {readingTime} min read
      </span>
    )}
  </a>
</article>
