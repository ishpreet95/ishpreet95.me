---
const currentYear = new Date().getFullYear();
---

<footer class="mt-24 bg-surface-low" style="color: var(--on-surface-variant);">
  <div class="max-w-[1200px] mx-auto px-6 lg:px-12 pt-16 pb-7">
    <!-- 4-column grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr] gap-8 lg:gap-14">
      <!-- Masthead -->
      <div>
        <a href="/" class="inline-flex items-center no-underline">
          <span
            class="relative w-8 h-8 rounded-full overflow-hidden inline-flex items-center justify-center"
            style="background: #0c0e10; box-shadow: inset 0 0 0 1px var(--ghost-border);"
          >
            <img
              src="/logo-mark.png"
              alt="Ishpreet"
              class="w-full h-full object-cover"
              style="mix-blend-mode: screen;"
            />
          </span>
        </a>
        <p class="font-serif italic text-[15px] text-on-surface-variant mt-5 mb-5 leading-relaxed max-w-[34ch]">
          A reading room for long investigations into developer tooling and AI engineering - written in public, one post at a time.
        </p>
        <div class="font-mono text-[11px] tracking-[0.08em] text-on-surface-variant uppercase opacity-75">
          Est. {currentYear}
        </div>
      </div>

      <!-- Site -->
      <div>
        <div class="eyebrow mb-3.5">Site</div>
        <ul class="list-none p-0 m-0 grid gap-2.5 text-[13px]">
          <li><a href="/" class="hover:text-on-surface transition-colors duration-150">Home</a></li>
          <li><a href="/blog" class="hover:text-on-surface transition-colors duration-150">Writing</a></li>
          <li><a href="/projects" class="hover:text-on-surface transition-colors duration-150">Projects</a></li>
          <li><a href="/about" class="hover:text-on-surface transition-colors duration-150">About</a></li>
        </ul>
      </div>

      <!-- Subscribe -->
      <div>
        <div class="eyebrow mb-3.5">Subscribe</div>
        <ul class="list-none p-0 m-0 grid gap-2.5 text-[13px]">
          <li>
            <a href="/rss.xml" class="inline-flex items-center gap-[7px] hover:text-on-surface transition-colors duration-150">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16" /><circle cx="5" cy="19" r="1.5" fill="currentColor" /></svg>
              RSS feed
            </a>
          </li>
          <li>
            <a href="https://x.com/IshpreetV95" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-[7px] hover:text-on-surface transition-colors duration-150">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M17.53 3h3.08l-6.73 7.69L22 21h-6.2l-4.86-6.36L5.28 21H2.2l7.2-8.22L2 3h6.36l4.39 5.81L17.53 3zm-1.08 16.13h1.7L7.63 4.78H5.8l10.65 14.35z" /></svg>
              Follow on X
            </a>
          </li>
        </ul>
      </div>

      <!-- Elsewhere -->
      <div>
        <div class="eyebrow mb-3.5">Elsewhere</div>
        <ul class="list-none p-0 m-0 grid gap-2.5 text-[13px]">
          <li>
            <a href="https://github.com/ishpreet95" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-[7px] hover:text-on-surface transition-colors duration-150">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 1.27a11 11 0 0 0-3.48 21.44c.55.1.75-.24.75-.53v-1.85c-3.06.66-3.71-1.48-3.71-1.48-.5-1.27-1.22-1.6-1.22-1.6-1-.68.08-.67.08-.67 1.1.08 1.68 1.13 1.68 1.13.98 1.68 2.57 1.2 3.2.91.1-.7.38-1.2.7-1.47-2.44-.28-5-1.22-5-5.43 0-1.2.43-2.18 1.13-2.94-.11-.28-.49-1.4.1-2.92 0 0 .92-.3 3.03 1.12a10.5 10.5 0 0 1 5.5 0c2.1-1.42 3.02-1.12 3.02-1.12.6 1.52.22 2.64.1 2.92.71.76 1.13 1.74 1.13 2.94 0 4.22-2.57 5.14-5.02 5.42.4.34.75 1 .75 2.03v3.01c0 .3.2.64.76.53A11 11 0 0 0 12 1.27z" /></svg>
              GitHub
            </a>
          </li>
          <li>
            <a href="https://www.linkedin.com/in/ishpreet-vashist/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-[7px] hover:text-on-surface transition-colors duration-150">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M4.98 3.5A2.5 2.5 0 1 1 5 8.5a2.5 2.5 0 0 1-.02-5zM3 9h4v12H3zM9 9h3.8v1.7h.06c.53-1 1.82-2.05 3.75-2.05 4 0 4.74 2.64 4.74 6.08V21h-4v-5.6c0-1.34-.02-3.06-1.87-3.06-1.87 0-2.16 1.46-2.16 2.96V21H9z" /></svg>
              LinkedIn
            </a>
          </li>
          <li>
            <a href="mailto:ishpreetsingh95@gmail.com" class="inline-flex items-center gap-[7px] hover:text-on-surface transition-colors duration-150">
              Email
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Colophon bar -->
    <div
      class="mt-14 pt-5 flex flex-col sm:flex-row items-start sm:items-baseline justify-between gap-4 text-[11.5px] font-mono text-on-surface-variant tracking-[0.04em]"
      style="border-top: 1px solid var(--ghost-border);"
    >
      <div>&copy; {currentYear} ISHPREET</div>
      <div class="hidden md:flex gap-[22px] opacity-80">
        <span>Set in Newsreader, Inter &amp; Geist Mono</span>
        <span>Built with Astro</span>
        <span>Hosted on Vercel</span>
      </div>
      <div class="opacity-70">v2.0</div>
    </div>
  </div>
</footer>
